{
  "name": "pi-review",
  "version": "2.1.0",
  "description": "Review and cleanup commands, methodology, report sink and roles for separately installed nicobailon/pi-subagents.",
  "type": "module",
  "license": "MIT",
  "author": "fyeeme",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "pi",
    "pi-package",
    "code-review",
    "simplify",
    "cleanup",
    "review"
  ],
  "files": [
    "*.ts",
    "src/**/*.ts",
    "skills/**/*.md",
    "prompts/**/*.md",
    "agents/**/*.md",
    "roles/**/*.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "skills/code-review",
      "skills/code-simplify"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write index.ts src/config.ts src/dispatch.ts test",
    "lint": "biome check index.ts src/config.ts src/dispatch.ts test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/bun": "latest",
    "@types/node": "22.19.19",
    "jiti": "2.7.0",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  }
}
